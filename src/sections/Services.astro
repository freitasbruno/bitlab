---
import ServiceCard from '../components/ServiceCard.astro';
---

<section class="services" id="services">
  <p class="section-tag reveal">What We Do</p>
  <h2 class="section-title reveal">Three ways we make<br>complexity disappear</h2>
  <p class="section-desc reveal">We don't build tech for tech's sake. Every tool, system, and recommendation starts with a broken workflow and ends with one that just works.</p>

  <div class="services-grid reveal">

    <ServiceCard
      title="Workflow Tools"
      description="Purpose-built applications that replace spreadsheet chaos, WhatsApp coordination, and manual tracking. We build what off-the-shelf can't."
    >
      <svg slot="illustration" viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="60" y1="50" x2="160" y2="40" stroke="#c8ff00" stroke-opacity="0.12" stroke-width="1"/>
        <line x1="160" y1="40" x2="260" y2="60" stroke="#c8ff00" stroke-opacity="0.12" stroke-width="1"/>
        <line x1="60" y1="50" x2="100" y2="110" stroke="#c8ff00" stroke-opacity="0.12" stroke-width="1"/>
        <line x1="160" y1="40" x2="160" y2="110" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="1"/>
        <line x1="260" y1="60" x2="220" y2="130" stroke="#c8ff00" stroke-opacity="0.12" stroke-width="1"/>
        <line x1="100" y1="110" x2="160" y2="110" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="1"/>
        <line x1="160" y1="110" x2="220" y2="130" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="1"/>
        <circle r="2" fill="#c8ff00" opacity="0.6"><animateMotion dur="3s" repeatCount="indefinite" path="M60,50 L160,40 L260,60"/></circle>
        <circle r="2" fill="#c8ff00" opacity="0.4"><animateMotion dur="4s" repeatCount="indefinite" path="M60,50 L100,110 L160,110 L220,130"/></circle>
        <rect x="44" y="34" width="32" height="32" rx="4" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <rect x="50" y="44" width="8" height="3" rx="1" fill="#c8ff00" opacity="0.5"/>
        <rect x="50" y="50" width="14" height="3" rx="1" fill="#c8ff00" opacity="0.3"/>
        <rect x="50" y="56" width="6" height="3" rx="1" fill="#c8ff00" opacity="0.2"/>
        <rect x="144" y="24" width="32" height="32" rx="4" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.5" stroke-width="1"/>
        <polygon points="160,36 164,44 156,44" fill="#c8ff00" opacity="0.5"/>
        <line x1="155" y1="47" x2="165" y2="47" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <rect x="244" y="44" width="32" height="32" rx="4" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <circle cx="260" cy="60" r="5" fill="none" stroke="#c8ff00" stroke-opacity="0.4" stroke-width="1"/>
        <circle cx="260" cy="60" r="2" fill="#c8ff00" opacity="0.4"/>
        <rect x="84" y="94" width="32" height="32" rx="4" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <rect x="90" y="104" width="20" height="2" rx="1" fill="#c8ff00" opacity="0.3"/>
        <rect x="90" y="109" width="14" height="2" rx="1" fill="#c8ff00" opacity="0.2"/>
        <rect x="90" y="114" width="18" height="2" rx="1" fill="#c8ff00" opacity="0.25"/>
        <rect x="144" y="94" width="32" height="32" rx="16" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.4" stroke-width="1"/>
        <text x="160" y="114" font-family="monospace" font-size="10" fill="#c8ff00" opacity="0.6" text-anchor="middle">AI</text>
        <rect x="204" y="114" width="32" height="32" rx="4" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <path d="M214,128 L218,124 L222,132 L226,126 L230,130" stroke="#c8ff00" stroke-opacity="0.4" stroke-width="1" fill="none"/>
      </svg>
    </ServiceCard>

    <ServiceCard
      title="AI Consultancy"
      description="Not a chatbot pitch. We assess your operations, find where AI creates real leverage, and implement it — from use-case discovery through change management."
    >
      <svg slot="illustration" viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="160" cy="90" r="65" stroke="#c8ff00" stroke-opacity="0.08" stroke-width="1" stroke-dasharray="4,6"/>
        <circle cx="160" cy="90" r="45" stroke="#c8ff00" stroke-opacity="0.12" stroke-width="1"/>
        <line x1="130" y1="65" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="190" y1="65" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="130" y1="115" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="190" y1="115" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="115" y1="90" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="205" y1="90" x2="160" y2="90" stroke="#c8ff00" stroke-opacity="0.15"/>
        <line x1="130" y1="65" x2="190" y2="65" stroke="#c8ff00" stroke-opacity="0.08"/>
        <line x1="130" y1="115" x2="190" y2="115" stroke="#c8ff00" stroke-opacity="0.08"/>
        <line x1="130" y1="65" x2="115" y2="90" stroke="#c8ff00" stroke-opacity="0.08"/>
        <line x1="190" y1="65" x2="205" y2="90" stroke="#c8ff00" stroke-opacity="0.08"/>
        <line x1="130" y1="115" x2="115" y2="90" stroke="#c8ff00" stroke-opacity="0.08"/>
        <line x1="190" y1="115" x2="205" y2="90" stroke="#c8ff00" stroke-opacity="0.08"/>
        <circle cx="160" cy="90" r="6" fill="#c8ff00" opacity="0.5"/>
        <circle cx="160" cy="90" r="12" fill="none" stroke="#c8ff00" stroke-opacity="0.2" stroke-width="1">
          <animate attributeName="r" values="12;16;12" dur="3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.2;0.05;0.2" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="130" cy="65" r="4" fill="#c8ff00" opacity="0.3"/>
        <circle cx="190" cy="65" r="4" fill="#c8ff00" opacity="0.3"/>
        <circle cx="130" cy="115" r="4" fill="#c8ff00" opacity="0.3"/>
        <circle cx="190" cy="115" r="4" fill="#c8ff00" opacity="0.3"/>
        <circle cx="115" cy="90" r="4" fill="#c8ff00" opacity="0.25"/>
        <circle cx="205" cy="90" r="4" fill="#c8ff00" opacity="0.25"/>
        <circle r="2" fill="#c8ff00" opacity="0.6"><animateMotion dur="2s" repeatCount="indefinite" path="M130,65 L160,90 L190,115"/></circle>
        <circle r="2" fill="#c8ff00" opacity="0.4"><animateMotion dur="2.5s" repeatCount="indefinite" path="M190,65 L160,90 L115,90"/></circle>
      </svg>
    </ServiceCard>

    <ServiceCard
      title="Process Architecture"
      description="Sometimes the tool isn't broken — the process is. We redesign how work flows so the right information reaches the right people at the right time."
    >
      <svg slot="illustration" viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <pattern id="bp" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <rect width="20" height="20" fill="none"/>
          <line x1="0" y1="20" x2="20" y2="20" stroke="#c8ff00" stroke-opacity="0.04" stroke-width="0.5"/>
          <line x1="20" y1="0" x2="20" y2="20" stroke="#c8ff00" stroke-opacity="0.04" stroke-width="0.5"/>
        </pattern>
        <rect x="40" y="20" width="240" height="140" fill="url(#bp)"/>
        <rect x="55" y="38" width="50" height="28" rx="3" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <text x="80" y="55" font-family="monospace" font-size="7" fill="#c8ff00" opacity="0.5" text-anchor="middle">INPUT</text>
        <line x1="105" y1="52" x2="130" y2="52" stroke="#c8ff00" stroke-opacity="0.2" stroke-width="1"/>
        <polygon points="130,49 136,52 130,55" fill="#c8ff00" opacity="0.2"/>
        <rect x="136" y="32" width="60" height="40" rx="3" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.4" stroke-width="1"/>
        <line x1="146" y1="45" x2="186" y2="45" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="0.5"/>
        <line x1="146" y1="52" x2="180" y2="52" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="0.5"/>
        <line x1="146" y1="59" x2="170" y2="59" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="0.5"/>
        <text x="166" y="42" font-family="monospace" font-size="6" fill="#c8ff00" opacity="0.35" text-anchor="middle">PROCESS</text>
        <line x1="196" y1="52" x2="218" y2="52" stroke="#c8ff00" stroke-opacity="0.2" stroke-width="1"/>
        <polygon points="218,49 224,52 218,55" fill="#c8ff00" opacity="0.2"/>
        <rect x="224" y="38" width="50" height="28" rx="3" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.3" stroke-width="1"/>
        <text x="249" y="55" font-family="monospace" font-size="7" fill="#c8ff00" opacity="0.5" text-anchor="middle">OUTPUT</text>
        <line x1="166" y1="72" x2="166" y2="90" stroke="#c8ff00" stroke-opacity="0.2" stroke-width="1"/>
        <polygon points="166,95 178,108 166,121 154,108" fill="#1a1a1a" stroke="#c8ff00" stroke-opacity="0.35" stroke-width="1"/>
        <text x="166" y="111" font-family="monospace" font-size="6" fill="#c8ff00" opacity="0.4" text-anchor="middle">IF</text>
        <line x1="178" y1="108" x2="220" y2="108" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="1"/>
        <text x="224" y="111" font-family="monospace" font-size="7" fill="#c8ff00" opacity="0.3">YES</text>
        <line x1="166" y1="121" x2="166" y2="145" stroke="#c8ff00" stroke-opacity="0.15" stroke-width="1"/>
        <text x="170" y="143" font-family="monospace" font-size="7" fill="#c8ff00" opacity="0.3">NO</text>
      </svg>
    </ServiceCard>

  </div>
</section>

<style>
  .services {
    background: var(--gray-1);
    position: relative;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 56px;
    background: var(--gray-2);
  }
  @media (max-width: 960px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
