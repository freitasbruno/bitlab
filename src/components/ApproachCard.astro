---
const { number, title, description } = Astro.props;
---

<div class="approach-card">
  <span class="approach-num">{String(number).padStart(2, '0')}</span>
  <h3>{title}</h3>
  <p>{description}</p>
</div>

<style>
  .approach-card {
    background: var(--black);
    padding: 40px 32px;
    position: relative;
    transition: all 0.4s var(--ease-out);
    overflow: hidden;
  }
  .approach-card:hover { background: var(--gray-1); }
  .approach-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .approach-card:hover::after { transform: scaleX(1); }
  .approach-num {
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.12;
    line-height: 1;
    margin-bottom: 24px;
    display: block;
    transition: opacity 0.4s;
  }
  .approach-card:hover .approach-num { opacity: 0.25; }
  .approach-card h3 { font-size: 18px; font-weight: 600; margin-bottom: 10px; line-height: 1.3; }
  .approach-card p  { font-size: 13px; color: var(--gray-3); line-height: 1.75; }
</style>
